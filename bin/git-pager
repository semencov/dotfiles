#!/usr/bin/env bun

import { $ } from "bun";
import { hasHelp } from "../src/utilities/arguments";
import { childExit, requireTools, runUtility, UtilityUsageError } from "../src/utilities/runtime";

const usage = "Usage: git-pager";
await runUtility(async () => {
  const args = Bun.argv.slice(2);
  if (hasHelp(args)) return void process.stdout.write(`${usage}\n`);
  if (args.length > 0) throw new UtilityUsageError(usage);
  await requireTools(["diff-so-fancy", "less"]);
  const result = await $`diff-so-fancy | less --chop-long-lines --quit-if-one-screen --no-init --tabs=1,5 -R`.nothrow();
  if (result.exitCode !== 0) childExit("git-pager", result.exitCode);
});
