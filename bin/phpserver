#!/usr/bin/env bun

import { $ } from "bun";
import { hasHelp } from "../src/utilities/arguments";
import { localIp } from "../src/utilities/network";
import { validatePort } from "../src/utilities/server";
import { childExit, requireTools, runUtility, UtilityUsageError } from "../src/utilities/runtime";

const usage = "Usage: phpserver [port]";
await runUtility(async () => {
  const args = Bun.argv.slice(2);
  if (hasHelp(args)) return void process.stdout.write(`${usage}\n`);
  if (args.length > 1) throw new UtilityUsageError(usage);
  await requireTools(["php"]);
  const port = validatePort(args[0], 4000);
  const ip = localIp();
  process.stdout.write(`Local: http://localhost:${port}/\nNetwork: http://${ip}:${port}/\n`);
  const result = await $`php -S ${`${ip}:${port}`}`.nothrow();
  if (result.exitCode !== 0) childExit("php", result.exitCode);
});
