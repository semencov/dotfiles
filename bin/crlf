#!/usr/bin/env bun

import { hasHelp, parseOperands } from "../src/utilities/arguments";
import { hasCrlf, normalizeCrlf } from "../src/utilities/crlf";
import { regularFiles } from "../src/utilities/files";
import { runUtility, UtilityUsageError } from "../src/utilities/runtime";

const usage = "Usage: crlf [--force] [file]";
await runUtility(async () => {
  const args = Bun.argv.slice(2);
  if (hasHelp(args)) return void process.stdout.write(`${usage}\n`);
  const { options, operands } = parseOperands(args, ["--force"]);
  if (operands.length > 1) throw new UtilityUsageError(usage);
  const files = operands[0] === undefined ? await regularFiles(process.cwd()) : [operands[0]];
  for (const path of files) {
    const bytes = new Uint8Array(await Bun.file(path).arrayBuffer());
    if (!hasCrlf(bytes)) continue;
    process.stdout.write(`${path}\n`);
    if (options.includes("--force")) await Bun.write(path, normalizeCrlf(bytes));
  }
});
