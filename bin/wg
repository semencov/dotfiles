#!/usr/bin/env bun

import { $ } from "bun";
import { hasHelp } from "../src/utilities/arguments";
import { childExit, requireTools, runUtility, UtilityUsageError } from "../src/utilities/runtime";

const usage = "Usage: wg <pattern> --replace|-r <replacement> [path ...]";
await runUtility(async () => {
  const args = Bun.argv.slice(2);
  if (hasHelp(args)) return void process.stdout.write(`${usage}\n`);
  if (!args.includes("--replace") && !args.includes("-r")) throw new UtilityUsageError(usage);
  await requireTools(["rg"]);
  const result = await $`rg --context 999999 --with-filename --heading --null --color never --no-line-number --max-columns 0 ${args}`.nothrow().quiet();
  if (result.exitCode === 1) {
    process.stdout.write("No files were changed\n");
    return 1;
  }
  if (result.exitCode !== 0) childExit("rg", result.exitCode);
  const parts = `${result.stdout.toString()}\n\0`.split("\0");
  let currentFile: string | undefined;
  let changed = 0;
  for (const part of parts.slice(0, -1)) {
    const lines = part.split("\n");
    if (currentFile !== undefined) {
      const contents = `${lines.slice(0, -2).join("\n")}\n`;
      await Bun.write(currentFile, contents);
      process.stdout.write(`${currentFile}\n`);
      changed += 1;
    }
    currentFile = lines.at(-1) || undefined;
  }
  return changed > 0 ? 0 : 1;
});
