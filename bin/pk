#!/usr/bin/env bun

import { hasHelp, requireOperandCount } from "../src/utilities/arguments";
import { packArchive, type PackKind } from "../src/utilities/archive";
import { runUtility, UtilityUsageError } from "../src/utilities/runtime";

const usage = "Usage: pk <tbz|tgz|txz|tar|bz2|gz|zip|7z> [path]";
const kinds = new Set<PackKind>(["tbz", "tgz", "txz", "tar", "bz2", "gz", "zip", "7z"]);
await runUtility(async () => {
  const args = Bun.argv.slice(2);
  if (hasHelp(args)) return void process.stdout.write(`${usage}\n`);
  requireOperandCount(args, [1, 2], usage);
  const kind = args[0] as PackKind;
  if (!kinds.has(kind)) throw new UtilityUsageError(usage);
  process.stdout.write(`${await packArchive(kind, args[1])}\n`);
});
