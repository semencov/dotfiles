#!/usr/bin/env bun

import { $ } from "bun";
import { mkdir, rm } from "node:fs/promises";
import { homedir } from "node:os";
import { basename, join, resolve } from "node:path";
import { hasHelp, parseOperands, requireOperandCount } from "../src/utilities/arguments";
import { childExit, requireTools, runUtility } from "../src/utilities/runtime";

const usage = "Usage: pj-archive [--remove] <folder ...>";
await runUtility(async () => {
  const args = Bun.argv.slice(2);
  if (hasHelp(args)) return void process.stdout.write(`${usage}\n`);
  const { options, operands } = parseOperands(args, ["--remove"]);
  requireOperandCount(operands, [1, Number.MAX_SAFE_INTEGER], usage);
  await requireTools(["7z"]);
  const destination = join(homedir(), "Projects", ".archive");
  await mkdir(destination, { recursive: true, mode: 0o700 });
  for (const folder of operands) {
    const source = resolve(folder);
    const archive = join(destination, `${basename(source)}.7z`);
    const result = await $`7z a ${archive} ${source}`.nothrow();
    if (result.exitCode !== 0) childExit("7z", result.exitCode);
    if (options.includes("--remove")) await rm(source, { recursive: true });
  }
});
