#!/usr/bin/env bun

import { $ } from "bun";
import { hasHelp, parseOperands, requireOperandCount } from "../src/utilities/arguments";
import { rsyncOperands } from "../src/utilities/rsync";
import { childExit, requireTools, runUtility, UtilityCancelledError } from "../src/utilities/runtime";
import { confirm } from "../src/utilities/terminal";

const usage = "Usage: rsync-from [--force] <remote>";
await runUtility(async () => {
  const args = Bun.argv.slice(2);
  if (hasHelp(args)) return void process.stdout.write(`${usage}\n`);
  const { options, operands } = parseOperands(args, ["--force"]);
  requireOperandCount(operands, 1, usage);
  if (!await confirm("Mirror remote into the current directory with deletion?", { force: options.includes("--force") })) throw new UtilityCancelledError();
  await requireTools(["rsync"]);
  const result = await $`rsync ${rsyncOperands("from", operands[0]!, process.cwd())}`.nothrow();
  if (result.exitCode !== 0) childExit("rsync", result.exitCode);
});
