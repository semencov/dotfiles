#!/usr/bin/env bun

import { $ } from "bun";
import { resolve } from "node:path";
import { hasHelp, parseOperands, requireOperandCount } from "../src/utilities/arguments";
import { generatedProjectArtifacts, removeProjectArtifacts } from "../src/utilities/projects";
import { childExit, runUtility } from "../src/utilities/runtime";

const usage = "Usage: pj-clean [--force] <folder ...>";
await runUtility(async () => {
  const args = Bun.argv.slice(2);
  if (hasHelp(args)) return void process.stdout.write(`${usage}\n`);
  const { options, operands } = parseOperands(args, ["--force"]);
  requireOperandCount(operands, [1, Number.MAX_SAFE_INTEGER], usage);
  const force = options.includes("--force");
  for (const folder of operands) {
    const root = resolve(folder);
    const artifacts = await generatedProjectArtifacts(root);
    for (const path of artifacts) process.stdout.write(`${path}\n`);
    if (!force) continue;
    const repository = await $`git rev-parse --git-dir`.cwd(root).nothrow().quiet();
    if (repository.exitCode === 0) {
      for (const operation of [
        () => $`git clean -fdx`.cwd(root).nothrow(),
        () => $`git reset --hard`.cwd(root).nothrow(),
        () => $`git prune`.cwd(root).nothrow(),
      ]) {
        const result = await operation();
        if (result.exitCode !== 0) childExit("git", result.exitCode);
      }
    }
    await removeProjectArtifacts(artifacts);
  }
});
