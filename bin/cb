#!/usr/bin/env bun

import { hasHelp } from "../src/utilities/arguments";
import { readClipboard, writeClipboard } from "../src/utilities/clipboard";
import { detectPlatform } from "../src/lib/platform";
import { runUtility, UtilityUsageError } from "../src/utilities/runtime";

const usage = "Usage: cb";
await runUtility(async () => {
  const args = Bun.argv.slice(2);
  if (hasHelp(args)) return void process.stdout.write(`${usage}\n`);
  if (args.length > 0) throw new UtilityUsageError(usage);
  const os = (await detectPlatform()).os;
  if (process.stdin.isTTY) process.stdout.write(await readClipboard(os));
  else await writeClipboard(await Bun.stdin.text(), os);
});
