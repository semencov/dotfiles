#!/usr/bin/env bun

import { hasHelp } from "../src/utilities/arguments";
import { localIp } from "../src/utilities/network";
import { runUtility, UtilityUsageError } from "../src/utilities/runtime";

const usage = "Usage: ip-lan";
await runUtility(async () => {
  const args = Bun.argv.slice(2);
  if (hasHelp(args)) return void process.stdout.write(`${usage}\n`);
  if (args.length > 0) throw new UtilityUsageError(usage);
  process.stdout.write(`${localIp()}\n`);
});
