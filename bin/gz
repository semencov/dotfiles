#!/usr/bin/env bun

import { $ } from "bun";
import { hasHelp, requireOperandCount } from "../src/utilities/arguments";
import { formatBytes } from "../src/utilities/files";
import { childExit, requireTools, runUtility } from "../src/utilities/runtime";

const usage = "Usage: gz <file>";
await runUtility(async () => {
  const args = Bun.argv.slice(2);
  if (hasHelp(args)) return void process.stdout.write(`${usage}\n`);
  requireOperandCount(args, 1, usage);
  await requireTools(["brotli", "gzip"]);
  const path = args[0]!;
  const original = Bun.file(path).size;
  const gzip = await $`gzip -c ${path}`.nothrow().quiet();
  if (gzip.exitCode !== 0) childExit("gzip", gzip.exitCode);
  const brotli = await $`brotli -c ${path}`.nothrow().quiet();
  if (brotli.exitCode !== 0) childExit("brotli", brotli.exitCode);
  const ratio = (size: number) => original === 0 ? "0.00" : (size * 100 / original).toFixed(2);
  process.stdout.write(`Original: ${formatBytes(original)}\n`);
  process.stdout.write(`Gzipped: ${formatBytes(gzip.stdout.byteLength)} (${ratio(gzip.stdout.byteLength)}%)\n`);
  process.stdout.write(`Brotli: ${formatBytes(brotli.stdout.byteLength)} (${ratio(brotli.stdout.byteLength)}%)\n`);
});
