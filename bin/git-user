#!/usr/bin/env bun

import { $ } from "bun";
import { hasHelp } from "../src/utilities/arguments";
import { assertGitRepository } from "../src/utilities/git";
import { childExit, requireTools, runUtility, UtilityUsageError } from "../src/utilities/runtime";

const usage = "Usage: git-user [-n <name>] [-e <email>]";
function parse(args: readonly string[]): { name?: string; email?: string } {
  const result: { name?: string; email?: string } = {};
  for (let index = 0; index < args.length; index += 2) {
    const flag = args[index];
    const value = args[index + 1];
    if (value === undefined || (flag !== "-n" && flag !== "-e")) throw new UtilityUsageError(usage);
    if (flag === "-n") result.name = value;
    else result.email = value;
  }
  return result;
}

await runUtility(async () => {
  const args = Bun.argv.slice(2);
  if (hasHelp(args)) return void process.stdout.write(`${usage}\n`);
  await requireTools(["git"]);
  await assertGitRepository(process.cwd());
  const { name, email } = parse(args);
  if (name !== undefined) {
    const result = await $`git config user.name ${name}`.nothrow();
    if (result.exitCode !== 0) childExit("git config", result.exitCode);
  }
  if (email !== undefined) {
    const result = await $`git config user.email ${email}`.nothrow();
    if (result.exitCode !== 0) childExit("git config", result.exitCode);
  }
  const currentName = (await $`git config user.name`.quiet().text()).trim();
  const currentEmail = (await $`git config user.email`.quiet().text()).trim();
  process.stdout.write(`${currentName} <${currentEmail}>\n`);
});
