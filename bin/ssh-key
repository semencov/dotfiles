#!/usr/bin/env bun

import { homedir, hostname, userInfo } from "node:os";
import { join } from "node:path";
import { hasHelp } from "../src/utilities/arguments";
import { ensurePublicKey, validateSshIdentifier } from "../src/utilities/ssh";
import { runUtility, UtilityUsageError } from "../src/utilities/runtime";

const usage = "Usage: ssh-key [identifier]";
await runUtility(async () => {
  const args = Bun.argv.slice(2);
  if (hasHelp(args)) return void process.stdout.write(`${usage}\n`);
  if (args.length > 1) throw new UtilityUsageError(usage);
  const identifier = args[0] === undefined ? "id_ed25519" : `${validateSshIdentifier(args[0])}.id_ed25519`;
  const key = join(homedir(), ".ssh", identifier);
  const publicKey = await ensurePublicKey(key, `${userInfo().username}@${hostname()} ${new Date().toISOString()}`);
  process.stdout.write(await Bun.file(publicKey).text());
});
