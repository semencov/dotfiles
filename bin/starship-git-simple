#!/usr/bin/env bun

import { $ } from "bun";
import { hasHelp } from "../src/utilities/arguments";
import { runUtility, UtilityUsageError } from "../src/utilities/runtime";

const usage = "Usage: starship-git-simple";
await runUtility(async () => {
  const args = Bun.argv.slice(2);
  if (hasHelp(args)) return void process.stdout.write(`${usage}\n`);
  if (args.length > 0) throw new UtilityUsageError(usage);
  if ((await $`git rev-parse --is-inside-work-tree`.nothrow().quiet()).exitCode !== 0) return;
  const branch = (await $`git branch --show-current`.quiet().text()).trim();
  if (branch.length === 0) return;
  const dirty = (await $`git status --short --ignore-submodules=dirty`.quiet().text()).trim().length > 0;
  process.stdout.write(`${dirty ? "\x1b[31m" : "\x1b[32m"}  ${branch}\x1b[0m\n`);
});
