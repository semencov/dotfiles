#!/usr/bin/env bun

import { hasHelp } from "../src/utilities/arguments";
import { fetchPublicIp } from "../src/utilities/network";
import { buildNamecheapUrl, parseNamecheapResponse, redactNamecheapUrl } from "../src/utilities/namecheap";
import { runUtility, UtilityOperationalError, UtilityUsageError } from "../src/utilities/runtime";

const usage = "Usage: update-namecheap -u <domain> -p <password> [-i <IP>] [-v] <host>";
function parse(args: readonly string[]) {
  let domain: string | undefined;
  let password: string | undefined;
  let ip: string | undefined;
  let verbose = false;
  const operands: string[] = [];
  for (let index = 0; index < args.length; index += 1) {
    const argument = args[index]!;
    if (argument === "-v") verbose = true;
    else if (argument === "-u" || argument === "-p" || argument === "-i") {
      const value = args[index + 1];
      if (value === undefined) throw new UtilityUsageError(usage);
      index += 1;
      if (argument === "-u") domain = value;
      else if (argument === "-p") password = value;
      else ip = value;
    } else if (argument.startsWith("-")) throw new UtilityUsageError(usage);
    else operands.push(argument);
  }
  if (domain === undefined || password === undefined || operands.length !== 1) throw new UtilityUsageError(usage);
  return { domain, password, host: operands[0]!, ip, verbose };
}

await runUtility(async () => {
  const args = Bun.argv.slice(2);
  if (hasHelp(args)) return void process.stdout.write(`${usage}\n`);
  const parsed = parse(args);
  const ip = parsed.ip ?? (await fetchPublicIp(process.env.PUBLIC_IP_ENDPOINT)).ip;
  const url = buildNamecheapUrl({ domain: parsed.domain, host: parsed.host, password: parsed.password, ip });
  if (parsed.verbose) process.stderr.write(`${redactNamecheapUrl(url)}\n`);
  let response: Response;
  try {
    response = await fetch(url, { signal: AbortSignal.timeout(15_000) });
  } catch {
    throw new UtilityOperationalError("Namecheap request failed");
  }
  if (!response.ok) throw new UtilityOperationalError(`Namecheap returned HTTP ${response.status}`);
  const result = parseNamecheapResponse(await response.text());
  if (result.errors.length > 0) throw new UtilityOperationalError(`Namecheap update failed: ${result.errors.join("; ")}`);
  process.stdout.write(`Host ${parsed.host}.${parsed.domain} bound to ${ip} successfully.\n`);
});
