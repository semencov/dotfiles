#!/usr/bin/env bun

import { $ } from "bun";
import { hasHelp } from "../src/utilities/arguments";
import { previousWorkday } from "../src/utilities/git";
import { childExit, requireTools, runUtility, UtilityUsageError } from "../src/utilities/runtime";

const usage = "Usage: git-standup";
await runUtility(async () => {
  const args = Bun.argv.slice(2);
  if (hasHelp(args)) return void process.stdout.write(`${usage}\n`);
  if (args.length > 0) throw new UtilityUsageError(usage);
  await requireTools(["git"]);
  const author = await $`git config user.name`.quiet().text();
  const since = previousWorkday(new Date()).toISOString();
  const result = await $`git log --no-merges ${"--pretty=format:%C(bold)%s%C(reset)  %cd, %h"} --date=local ${`--since=${since}`} ${`--author=${author.trim()}`}`.nothrow();
  if (result.exitCode !== 0) childExit("git log", result.exitCode);
});
