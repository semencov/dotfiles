#!/usr/bin/env bun

import { hasHelp } from "../src/utilities/arguments";
import { fetchIpDetails, renderIpDetails } from "../src/utilities/network";
import { runUtility, UtilityUsageError } from "../src/utilities/runtime";

const usage = "Usage: ip-query [IP]";
await runUtility(async () => {
  const args = Bun.argv.slice(2);
  if (hasHelp(args)) return void process.stdout.write(`${usage}\n`);
  if (args.length > 1) throw new UtilityUsageError(usage);
  const endpoint = process.env.IP_QUERY_ENDPOINT ?? "https://api.ipquery.io/";
  const separator = endpoint.includes("?") ? "&" : "?";
  const details = await fetchIpDetails(`${endpoint}${encodeURIComponent(args[0] ?? "")}${separator}format=json`);
  process.stdout.write(`${renderIpDetails(details)}\n`);
});
