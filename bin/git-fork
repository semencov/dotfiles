#!/usr/bin/env bun

import { $ } from "bun";
import { basename } from "node:path";
import { hasHelp, requireOperandCount } from "../src/utilities/arguments";
import { validGitHubOwner } from "../src/utilities/git";
import { childExit, requireTools, runUtility, UtilityUsageError } from "../src/utilities/runtime";

const usage = "Usage: git-fork <original-owner>";
await runUtility(async () => {
  const args = Bun.argv.slice(2);
  if (hasHelp(args)) return void process.stdout.write(`${usage}\n`);
  requireOperandCount(args, 1, usage);
  const owner = args[0]!;
  if (!validGitHubOwner(owner)) throw new UtilityUsageError("Invalid GitHub owner");
  await requireTools(["git"]);
  const repository = basename(process.cwd());
  const result = await $`git remote add upstream ${`git@github.com:${owner}/${repository}.git`}`.nothrow();
  if (result.exitCode !== 0) childExit("git remote add", result.exitCode);
});
