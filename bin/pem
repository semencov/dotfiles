#!/usr/bin/env bun

import { $ } from "bun";
import { chmod, unlink } from "node:fs/promises";
import { hasHelp } from "../src/utilities/arguments";
import { childExit, requireTools, runUtility } from "../src/utilities/runtime";

const usage = "Usage: pem";
await runUtility(async () => {
  const args = Bun.argv.slice(2);
  if (hasHelp(args)) return void process.stdout.write(`${usage}\n`);
  if (args.length > 0) throw new Error(usage);
  await requireTools(["openssl"]);
  for (const [name, operation] of [
    ["openssl genrsa", $`openssl genrsa -out ./key.pem -aes256 1024`.nothrow()],
    ["openssl req", $`openssl req -new -key ./key.pem -out ./csr.pem`.nothrow()],
    ["openssl x509", $`openssl x509 -req -days 9999 -in ./csr.pem -signkey ./key.pem -out ./cert.pem`.nothrow()],
  ] as const) {
    const result = await operation;
    if (result.exitCode !== 0) childExit(name, result.exitCode);
  }
  await unlink("./csr.pem");
  await Promise.all([chmod("./key.pem", 0o600), chmod("./cert.pem", 0o600)]);
});
