#!/usr/bin/env bun

import { hasHelp, parseOperands } from "../src/utilities/arguments";
import { changedFilesSinceDefault } from "../src/utilities/git";
import { requireTools, runUtility, UtilityUsageError } from "../src/utilities/runtime";

const usage = "Usage: git-diff-master [--inline] [pattern]";
await runUtility(async () => {
  const args = Bun.argv.slice(2);
  if (hasHelp(args)) return void process.stdout.write(`${usage}\n`);
  const { options, operands } = parseOperands(args, ["--inline"]);
  if (operands.length > 1) throw new UtilityUsageError(usage);
  await requireTools(["git"]);
  let pattern: RegExp | undefined;
  try {
    if (operands[0] !== undefined) pattern = new RegExp(operands[0]);
  } catch {
    throw new UtilityUsageError(`Invalid pattern: ${operands[0]}`);
  }
  const files = await changedFilesSinceDefault(process.cwd(), pattern);
  process.stdout.write(files.length === 0 ? "" : `${files.join(options.includes("--inline") ? " " : "\n")}\n`);
});
