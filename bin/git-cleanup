#!/usr/bin/env bun

import { $ } from "bun";
import { hasHelp, parseOperands } from "../src/utilities/arguments";
import { cleanupCandidates } from "../src/utilities/git";
import { childExit, requireTools, runUtility, UtilityUsageError } from "../src/utilities/runtime";

const usage = "Usage: git-cleanup [--force]";
await runUtility(async () => {
  const args = Bun.argv.slice(2);
  if (hasHelp(args)) return void process.stdout.write(`${usage}\n`);
  const { options, operands } = parseOperands(args, ["--force"]);
  if (operands.length > 0) throw new UtilityUsageError(usage);
  await requireTools(["git"]);
  const candidates = await cleanupCandidates(process.cwd(), new Date());
  for (const candidate of candidates) process.stdout.write(`${candidate.name}\t${candidate.reason}\n`);
  if (!options.includes("--force")) return;
  for (const operation of [$`git prune`.nothrow(), $`git remote prune origin`.nothrow()]) {
    const result = await operation;
    if (result.exitCode !== 0) childExit("git cleanup", result.exitCode);
  }
  for (const { name } of candidates) {
    const result = await $`git branch -D ${name}`.nothrow();
    if (result.exitCode !== 0) childExit("git branch", result.exitCode);
  }
});
