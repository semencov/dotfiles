#!/usr/bin/env bun

import { $ } from "bun";
import { hasHelp, parseOperands } from "../src/utilities/arguments";
import { fetchIpDetails, renderIpDetails } from "../src/utilities/network";
import { childExit, requireTools, runUtility, UtilityUsageError } from "../src/utilities/runtime";

const usage = "Usage: ip-geo [--map] [IP]";
await runUtility(async () => {
  const args = Bun.argv.slice(2);
  if (hasHelp(args)) return void process.stdout.write(`${usage}\n`);
  const { options, operands } = parseOperands(args, ["--map", "-m"]);
  if (operands.length > 1) throw new UtilityUsageError(usage);
  const endpoint = process.env.IP_GEO_ENDPOINT ?? "http://ip-api.com/json/";
  const details = await fetchIpDetails(`${endpoint}${encodeURIComponent(operands[0] ?? "")}`);
  process.stdout.write(`${renderIpDetails(details)}\n`);
  if (options.includes("--map") || options.includes("-m")) {
    const url = `https://www.google.com/maps/search/?api=1&query=${details.lat},${details.lon}`;
    const tool = process.platform === "darwin" ? "open" : "xdg-open";
    await requireTools([tool]);
    const result = tool === "open" ? await $`open ${url}`.nothrow() : await $`xdg-open ${url}`.nothrow();
    if (result.exitCode !== 0) childExit(tool, result.exitCode);
  }
});
