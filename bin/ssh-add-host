#!/usr/bin/env bun

import { $ } from "bun";
import { homedir, userInfo } from "node:os";
import { join } from "node:path";
import { hasHelp } from "../src/utilities/arguments";
import { addSshHost, ensurePublicKey, validateSshHost, validateSshIdentifier } from "../src/utilities/ssh";
import { childExit, requireTools, runUtility, UtilityUsageError } from "../src/utilities/runtime";

const usage = "Usage: ssh-add-host [-a alias] [-u username] [-p port] <host>";
function parse(args: readonly string[]) {
  let identifier: string | undefined;
  let username = userInfo().username;
  let port = 22;
  const operands: string[] = [];
  for (let index = 0; index < args.length; index += 1) {
    const argument = args[index]!;
    if (argument === "-a" || argument === "-u" || argument === "-p") {
      const value = args[index + 1];
      if (value === undefined) throw new UtilityUsageError(usage);
      index += 1;
      if (argument === "-a") identifier = validateSshIdentifier(value);
      else if (argument === "-u") username = value;
      else {
        port = Number(value);
        if (!Number.isInteger(port) || port < 1 || port > 65_535) throw new UtilityUsageError("Invalid SSH port");
      }
    } else if (argument.startsWith("-")) throw new UtilityUsageError(usage);
    else operands.push(argument);
  }
  if (operands.length !== 1 || !/^[A-Za-z0-9._-]+$/.test(username)) throw new UtilityUsageError(usage);
  const host = validateSshHost(operands[0]!);
  return { host, identifier: identifier ?? validateSshIdentifier(host.replaceAll(".", "_")), username, port };
}

await runUtility(async () => {
  const args = Bun.argv.slice(2);
  if (hasHelp(args)) return void process.stdout.write(`${usage}\n`);
  await requireTools(["ssh", "ssh-keygen"]);
  const parsed = parse(args);
  const sshDirectory = join(homedir(), ".ssh");
  const privateKey = join(sshDirectory, `${parsed.identifier}.id_ed25519`);
  const publicKey = await ensurePublicKey(privateKey, `${userInfo().username}@${parsed.host}`);
  await addSshHost(join(sshDirectory, "config"), {
    ...parsed,
    identityFile: `~/.ssh/${parsed.identifier}.id_ed25519`,
  });
  const publicKeyContents = await Bun.file(publicKey).text();
  for (const operation of [
    () => $`ssh ${parsed.identifier} mkdir -p .ssh`.nothrow(),
    () => $`ssh ${parsed.identifier} chmod 700 .ssh`.nothrow(),
    () => $`printf %s ${publicKeyContents} | ssh ${parsed.identifier} tee -a .ssh/authorized_keys`.nothrow().quiet(),
    () => $`ssh ${parsed.identifier} chmod 600 .ssh/authorized_keys`.nothrow(),
    () => $`ssh -o PasswordAuthentication=no ${parsed.identifier} true`.nothrow(),
  ]) {
    const result = await operation();
    if (result.exitCode !== 0) childExit("ssh", result.exitCode);
  }
  process.stdout.write("SSH key added.\n");
});
