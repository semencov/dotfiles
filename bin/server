#!/usr/bin/env bun

import { hasHelp } from "../src/utilities/arguments";
import { localIp } from "../src/utilities/network";
import { startStaticServer, validatePort } from "../src/utilities/server";
import { runUtility, UtilityUsageError } from "../src/utilities/runtime";

const usage = "Usage: server [port]";
await runUtility(async () => {
  const args = Bun.argv.slice(2);
  if (hasHelp(args)) return void process.stdout.write(`${usage}\n`);
  if (args.length > 1) throw new UtilityUsageError(usage);
  const port = validatePort(args[0], 8000);
  const server = startStaticServer(process.cwd(), port);
  process.stdout.write(`Local: ${server.url}\nNetwork: http://${localIp()}:${server.port}/\n`);
});
