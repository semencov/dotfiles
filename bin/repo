#!/usr/bin/env bun

import { hasHelp, requireOperandCount } from "../src/utilities/arguments";
import { findProject, projectRootsFromLocalConfig } from "../src/utilities/projects";
import { runUtility } from "../src/utilities/runtime";

const usage = "Usage: repo <name>";
await runUtility(async () => {
  const args = Bun.argv.slice(2);
  if (hasHelp(args)) return void process.stdout.write(`${usage}\n`);
  requireOperandCount(args, 1, usage);
  process.stdout.write(`${await findProject(await projectRootsFromLocalConfig(), args[0]!)}\n`);
});
