#!/usr/bin/env bun

import { $ } from "bun";
import { hasHelp } from "../src/utilities/arguments";
import { validateCommitMessage } from "../src/utilities/git";
import { childExit, requireTools, runUtility, UtilityCancelledError, UtilityOperationalError, UtilityUsageError } from "../src/utilities/runtime";

const usage = "Usage: yolo";
const dim = (value: string) => `\x1b[2m${value}\x1b[0m`;

async function spinner<T>(message: string, task: () => Promise<T>): Promise<T> {
  if (!process.stderr.isTTY) return task();
  const frames = ["-", "\\", "|", "/"];
  let index = 0;
  const interval = setInterval(() => process.stderr.write(`\r${dim(`${frames[index++ % frames.length]} ${message}`)}`), 80);
  try {
    return await task();
  } finally {
    clearInterval(interval);
    process.stderr.write(`\r${" ".repeat(message.length + 2)}\r`);
  }
}

async function editableQuestion(query: string, initial: string): Promise<string> {
  if (!process.stdin.isTTY) throw new UtilityOperationalError("yolo requires an interactive terminal");
  return new Promise<string>((resolve, reject) => {
    let answer = initial;
    let cursor = initial.length;
    const visibleLength = query.replace(/\x1b\[[0-9;]*m/g, "").length;
    const redraw = () => {
      process.stdout.write(`\r\x1b[2K${query}${answer}\r\x1b[${visibleLength + cursor}C`);
    };
    const cleanup = () => {
      process.stdin.setRawMode(false);
      process.stdin.pause();
      process.stdin.off("data", onData);
    };
    const onData = (data: Buffer) => {
      const input = data.toString("utf8");
      if (input === "\u0003") {
        cleanup();
        process.stdout.write("\n");
        reject(new UtilityCancelledError());
      } else if (input === "\r" || input === "\n") {
        cleanup();
        process.stdout.write("\n");
        resolve(answer);
      } else if (input === "\u007f" && cursor > 0) {
        answer = answer.slice(0, cursor - 1) + answer.slice(cursor);
        cursor -= 1;
        redraw();
      } else if (input === "\x1b[D") {
        cursor = Math.max(0, cursor - 1);
        redraw();
      } else if (input === "\x1b[C") {
        cursor = Math.min(answer.length, cursor + 1);
        redraw();
      } else if (input.length === 1 && input >= " ") {
        answer = answer.slice(0, cursor) + input + answer.slice(cursor);
        cursor += 1;
        redraw();
      }
    };
    process.stdin.setRawMode(true);
    process.stdin.resume();
    process.stdin.on("data", onData);
    redraw();
  });
}

await runUtility(async () => {
  const args = Bun.argv.slice(2);
  if (hasHelp(args)) return void process.stdout.write(`${usage}\n`);
  if (args.length > 0) throw new UtilityUsageError(usage);
  await requireTools(["fx", "git"]);
  const diff = await $`git diff --cached`.quiet().text();
  if (diff.trim().length === 0) throw new UtilityOperationalError("No staged changes");
  const branch = await $`git branch --show-current`.quiet().text();
  const jiraKey = branch.match(/[A-Z]+-[0-9]+/)?.[0];
  const instruction = jiraKey === undefined
    ? "Use conventional commits format with an optional short lowercase scope."
    : `Prefix the message with '${jiraKey}: '.`;
  const prompt = `Generate one imperative Git commit message under 256 characters. ${instruction} Output only the message.\n\n${diff}`;
  const response: unknown = await spinner("Generating commit message...", () => $`fx ask ${prompt} --no-save --json`.json());
  const generated = typeof response === "object" && response !== null && "output" in response && typeof response.output === "string"
    ? response.output
    : jiraKey === undefined ? "" : `${jiraKey}: `;
  const message = validateCommitMessage(await editableQuestion(dim("Commit message: "), generated));
  const result = await $`git commit -m ${message}`.nothrow();
  if (result.exitCode !== 0) childExit("git commit", result.exitCode);
});
