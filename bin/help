#!/usr/bin/env bun

import { join, resolve } from "node:path";
import { hasHelp } from "../src/utilities/arguments";
import { CommandCatalog } from "../src/utilities/catalog";
import { runUtility, UtilityUsageError } from "../src/utilities/runtime";

const usage = "Usage: help [command]";
await runUtility(async () => {
  const args = Bun.argv.slice(2);
  if (hasHelp(args)) return void process.stdout.write(`${usage}\n`);
  if (args.length > 1) throw new UtilityUsageError(usage);
  const repository = resolve(import.meta.dir, "..");
  const catalog = await CommandCatalog.load(join(repository, "config", "commands.json"));
  if (args[0] !== undefined) {
    const command = catalog.get(args[0]);
    if (command === undefined) throw new UtilityUsageError(`Unknown command: ${args[0]}`);
    process.stdout.write(`${command.name}: ${command.summary}\n`);
    return;
  }
  for (const command of catalog.commands) process.stdout.write(`${command.name.padEnd(22)} ${command.summary}\n`);
});
