#!/usr/bin/env bun

import { runCli } from "../src/cli/main";
import { createProductionDependencies } from "../src/cli/production";
import { publicErrorMessage } from "../src/lib/errors";

try {
  const dependencies = await createProductionDependencies();
  process.exitCode = await runCli(process.argv, dependencies);
} catch (error) {
  process.stderr.write(`${publicErrorMessage(error)}\n`);
  process.exitCode = 1;
}
