{
  "extends": "@total-typescript/tsconfig/tsc/no-dom/library",
  "compilerOptions": {
    "noEmit": true,
    "skipLibCheck": true,
    "allowJs": false,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "useUnknownInCatchVariables": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "types": [
      "bun"
    ]
  },
  "include": [
    "src/**/*.ts",
    "tests/**/*.ts",
    "bin/**/*"
  ],
  "exclude": [
    "node_modules",
    "**/*.js",
    "**/*.mjs"
  ]
}
