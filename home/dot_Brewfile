tap "github/gh"
tap "git-friendly/git-friendly"
tap "oven-sh/bun"

if OS.mac?
  tap "buo/cask-upgrade"
  tap "mas-cli/tap"
  cask_args appdir: "/Applications"
end

# Zsh Essentials
brew "zsh"
brew "starship"
brew "zsh-completions"
brew "zsh-autosuggestions"
brew "zsh-syntax-highlighting"

# System tools
brew "uutils-coreutils"
brew "uutils-findutils"
brew "autoconf"
brew "bats-core"
brew "pkg-config"
brew "chezmoi"
brew "mackup"
brew "shellcheck"

# Utils
brew "bat", args: ["build-from-source"]
brew "micro"
brew "cloc"
brew "pwgen"
brew "vips"

# Compression tools
brew "ouch"
brew "p7zip"

# Filesystem tools
brew "fd"
brew "fzf"
brew "tree"
brew "grex"
brew "ripgrep"
brew "eza"

# Network tools
brew "wget"
brew "curl"
brew "hurl"
brew "httpie"
brew "dog"

# Git
brew "gh"
brew "gist"
brew "git"
brew "git-delta"
brew "git-extras"
brew "git-flow"
brew "git-fresh"
brew "git-recent"
brew "git-when-merged"
brew "git-friendly/git-friendly/git-friendly"

# Node.js
brew "fnm"
brew "deno"
brew "oven-sh/bun/bun"

# Python
brew "python"
brew "uv"

# Rust
brew "rust"

# GUI tools
brew "lazygit"
brew "lazyssh"
brew "htop"
brew "midnight-commander"
brew "ncdu"
brew "yazi"

# AI tools
brew "codex"

if OS.mac?
  # macOS tools
  brew "mas"
  brew "mactop"

  # Java
  cask "java" unless system "/usr/libexec/java_home --failfast"

  # Applications
  cask "ilya-birman-typography-layout"
  cask "claude-code"
  cask "container"
  cask "google-chrome"
  cask "firefox"
  cask "cmux"
  cask "zed"

  # Fonts
  cask "font-fira-code"
  cask "font-fira-code-nerd-font"
  cask "font-powerline-symbols"
end
