{
  "name": "dotfiles",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "check:bin": "bun test tests/utilities/bin-contract.test.ts tests/utilities/docs.test.ts",
    "docs:commands": "bun src/utilities/docs.ts --write",
    "dotfiles": "bun bin/dotfiles",
    "test": "bun test",
    "typecheck": "tsc --noEmit -p tsconfig.json && bun src/utilities/typecheck-bin.ts"
  },
  "engines": {
    "bun": ">=1.2"
  },
  "dependencies": {
    "@clack/prompts": "^1.7.0",
    "@total-typescript/tsconfig": "^1.0.4",
    "commander": "^15.0.0",
    "typescript": "^6.0.3"
  },
  "devDependencies": {
    "@types/bun": "^1.4.0"
  }
}
